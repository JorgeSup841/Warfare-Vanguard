# Copia como application-local.properties, no lo incluyas en Git.
# Activa el perfil local con SPRING_PROFILES_ACTIVE=local.
# Sustituye los valores marcados REPLACE_ por valores reales, nunca los compartas.

spring.datasource.url=REPLACE_JDBC_URL
spring.datasource.username=REPLACE_DATABASE_USER
spring.datasource.password=REPLACE_DATABASE_PASSWORD
jwt.secret=REPLACE_BASE64_32_BYTES
app.otp.pepper=REPLACE_DIFFERENT_BASE64_32_BYTES
app.crypto.key=REPLACE_DIFFERENT_BASE64_32_BYTES
spring.mail.username=REPLACE_GMAIL_ADDRESS
spring.mail.password=REPLACE_GMAIL_APP_PASSWORD
app.mail.from=REPLACE_GMAIL_ADDRESS

app.cors.allowed-origin=http://localhost:4200
app.openapi.public=true
